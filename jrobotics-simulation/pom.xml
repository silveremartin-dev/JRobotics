<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jrobotics</groupId>
        <artifactId>jrobotics-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jrobotics-simulation</artifactId>
    <packaging>jar</packaging>

    <name>JRobotics Simulation</name>
    <description>Physics simulation environment for JRobotics</description>

    <dependencies>
        <dependency>
            <groupId>org.jrobotics</groupId>
            <artifactId>jrobotics-core</artifactId>
        </dependency>

        <!-- jMonkeyEngine core for 3D rendering (optional, physics is custom) -->
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-core</artifactId>
        </dependency>

        <!-- Note: jme3-bullet and jme3-bullet-native are not available in Maven Central.
             Using custom simple physics implementation instead. 
             For advanced physics, users can integrate their own physics engine. -->
        <!-- JMonkeyEngine (Full support for Visualizer) -->
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-desktop</artifactId>
            <version>3.6.1-stable</version>
        </dependency>
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-lwjgl3</artifactId>
            <version>3.6.1-stable</version>
        </dependency>
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-plugins</artifactId>
            <version>3.6.1-stable</version>
        </dependency>

        <!-- JavaFX (For 2D Visualizer) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21</version>
        </dependency>
    </dependencies>
</project>
