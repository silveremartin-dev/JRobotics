<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.jrobotics</groupId>
        <artifactId>jrobotics-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>jrobotics-robot</artifactId>
    <packaging>jar</packaging>

    <name>JRobotics Robot</name>
    <description>Robot implementations for JRobotics</description>

    <dependencies>
        <dependency>
            <groupId>org.jrobotics</groupId>
            <artifactId>jrobotics-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jrobotics</groupId>
            <artifactId>jrobotics-sensor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jrobotics</groupId>
            <artifactId>jrobotics-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jrobotics</groupId>
            <artifactId>jrobotics-hal</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jrobotics</groupId>
            <artifactId>jrobotics-simulation</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- JMonkeyEngine 3D (optional) -->
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-core</artifactId>
            <version>3.6.1-stable</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-desktop</artifactId>
            <version>3.6.1-stable</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-lwjgl3</artifactId>
            <version>3.6.1-stable</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.jmonkeyengine</groupId>
            <artifactId>jme3-plugins</artifactId>
            <version>3.6.1-stable</version>
            <optional>true</optional>
        </dependency>

        <!-- JavaFX (optional) -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21</version>
            <optional>true</optional>
        </dependency>
    </dependencies>
</project>
